@page
@model WebApplication2.Pages.Members.IndexModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Gestiune Membri (Conturi Înregistrate)</h1>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Member[0].Name)</th>
            <th>@Html.DisplayNameFor(model => model.Member[0].Email)</th>
            <th>@Html.DisplayNameFor(model => model.Member[0].Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Member[0].City)</th>
            <th>Acțiuni</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Member != null)
        {
            @foreach (var item in Model.Member)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                    <td>@Html.DisplayFor(modelItem => item.City)</td>
                    <td>
                        <a asp-page="./Details" asp-route-id="@item.ID">Details</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>